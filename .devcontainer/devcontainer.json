{
  "name": "HOGD Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "CCACHE_DIR": "/home/builder/.cache/ccache",
    "CCACHE_MAXSIZE": "5G",
    "CARGO_NET_GIT_FETCH_WITH_CLI": "true"
  },
  "remoteEnv": {
    "CARGO_REGISTRIES_GROUNDHOG_TOKEN": "${localEnv:CARGO_REGISTRIES_GROUNDHOG_TOKEN}"
  },
  "mounts": [
    "source=hogd-ccache,target=/home/builder/.cache/ccache,type=volume",
    "source=hogd-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=hogd-cargo-git,target=/usr/local/cargo/git,type=volume"
  ],
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "ms-python.python",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "clangd.path": "clangd",
        "clangd.arguments": [
          "--background-index",
          "--clang-tidy",
          "--header-insertion=iwyu",
          "--completion-style=detailed"
        ],
        "cmake.configureOnOpen": false,
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true,
        "[cpp]": {
          "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
        },
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  "initializeCommand": "docker volume create hogd-ccache; docker volume create hogd-cargo-registry; docker volume create hogd-cargo-git || true",
  "postCreateCommand": "git submodule update --init --recursive --force && if [ -n \"${CARGO_REGISTRIES_GROUNDHOG_TOKEN:-}\" ]; then ./scripts/fetch.sh; else printf '\nCargo registry token missing. Set CARGO_REGISTRIES_GROUNDHOG_TOKEN in the environment that launches VS Code, then rebuild the container.\n\n'; fi",
  "remoteUser": "builder"
}
