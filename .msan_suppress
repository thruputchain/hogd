# MSan false positives from uninstrumented system libraries.
#
# Suppressions match any function name that appears anywhere in the stack.
# Use wildcards to cover the breadth of OpenSSL internals.

# OpenSSL — entirely uninstrumented.
# MSan can only match on instrumented frames, so we suppress our wrapper
# functions that call into OpenSSL rather than the OpenSSL symbols themselves.
fun:*ossl_*
fun:*OPENSSL_*
fun:*openssl_*
fun:*EVP_*
fun:*evp_*
fun:*RAND_*
fun:*rand_*
fun:*CRYPTO_*
fun:*BIO_*
fun:*CONF_*
fun:*drbg_*
# Our instrumented wrappers around OpenSSL
fun:*read_random*
fun:*SipHash24*
fun:*sha256*
fun:*hogd*blake3*

# MSan interceptors that fire inside uninstrumented code.
# These are broad but necessary — MSan checks frame #0 for suppressions,
# and when memcmp/bcmp are called from uninstrumented OpenSSL internals,
# the only matching frame is the interceptor itself.
fun:memcmp
fun:bcmp
fun:memcpy
fun:fopen64

# System compression libraries — uninstrumented
fun:*snappy*
fun:*LZ4*
fun:*ZSTD*
fun:*BZ2*
fun:*deflate*
fun:*inflate*
