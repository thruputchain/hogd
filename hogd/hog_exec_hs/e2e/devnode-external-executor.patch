 namespace hogd {
 
+namespace {
+
+// The external executor started by the test hook, if any.
+pid_t &
+external_executor_pid()
+{
+  static pid_t pid = 0;
+  return pid;
+}
+
+void
+stop_external_executor()
+{
+  pid_t &pid = external_executor_pid();
+  if (pid > 0) {
+    kill(pid, SIGTERM);
+    waitpid(pid, nullptr, 0);
+    pid = 0;
+  }
+}
+
+} // namespace
+
 namespace {
