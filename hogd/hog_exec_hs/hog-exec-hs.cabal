cabal-version: 2.4
name:          hog-exec-hs
version:       0.1.0.0
synopsis:      Haskell implementation of the hogd transaction executor (hog_exec)
license:       NONE
build-type:    Simple
extra-source-files:
  cbits/mldsa-native/LICENSE
  cbits/mldsa-native/*.c
  cbits/mldsa-native/*.h
  cbits/mldsa-native/src/*.c
  cbits/mldsa-native/src/*.h
  cbits/mldsa-native/src/*.inc
  cbits/mldsa-native/src/fips202/*.c
  cbits/mldsa-native/src/fips202/*.h

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-do-bind
  build-depends:    base >=4.17 && <5

common exts
  default-extensions: DuplicateRecordFields, OverloadedRecordDot, PatternSynonyms, LambdaCase, OverloadedStrings

executable xdrgen
  import:         shared
  hs-source-dirs: xdrgen
  main-is:        Main.hs
  build-depends:  containers, directory, filepath, parsec

library
  import:          shared, exts
  hs-source-dirs:  src
  build-depends:
    bytestring, containers, network, async, stm, time, unix, vector, primitive,
    base16-bytestring, crypton >=1.0.6 && <1.1, memory >=0.18 && <0.19
  -- mldsa-native, built twice as hogd/crypto/CMakeLists.txt does: once to
  -- verify (Hogd.Crypto.MlDsa) and once to sign (Hogd.Crypto.MlDsaSigner).
  -- Each wrapper sets its MLD_CONFIG_* and includes mldsa_native.c.
  c-sources:
    cbits/hogd_mldsa65_verify.c
    cbits/hogd_mldsa65_signer.c
  include-dirs:    cbits/mldsa-native
  cc-options:      -O2 -std=c99
  exposed-modules:
    Hogd.Base.NetworkConfigParams
    Hogd.Base.Types
    Hogd.Base.XdrUtil
    Hogd.BuiltContracts.Codec
    Hogd.BuiltContracts.DefaultWallet
    Hogd.BuiltContracts.ItcErc20
    Hogd.Crypto
    Hogd.Crypto.DomainSeparators
    Hogd.Crypto.Ed25519
    Hogd.Crypto.MlDsa
    Hogd.Crypto.MlDsaSigner
    Hogd.Exec.Common.Int128
    Hogd.Exec.Common.Limits
    Hogd.Exec.Common.Status
    Hogd.Exec.Components.ContractResult
    Hogd.Exec.Components.ExecutionMode
    Hogd.Exec.Http
    Hogd.Exec.Interface.Executor
    Hogd.Exec.Interface.ViewGateway
    Hogd.Exec.Log
    Hogd.Exec.Metrics
    Hogd.Exec.Precompiles.Context
    Hogd.Exec.Precompiles.NativeContractBuilder
    Hogd.Exec.Precompiles.PrecompileDefaultWallet
    Hogd.Exec.Precompiles.PrecompileNativeToken
    Hogd.Exec.Runtime.ContractTrait
    Hogd.Exec.Runtime.ContractTraitClient
    Hogd.Exec.Runtime.EventServerProxy
    Hogd.Exec.Runtime.GasCostTable
    Hogd.Exec.Runtime.InvocationFrame
