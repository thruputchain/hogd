executable hog-exec-hs
  import:         shared, exts
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:  hog-exec-hs

test-suite hog-exec-hs-test
  import:         shared, exts
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  other-modules:
    ContractTraitSpec
    CryptoSpec
    DefaultWalletSpec
    Ed25519EdgeCases
    ExecutionModeSpec
    Harness.Env
    Harness.FakeDb
    Harness.FakeEventServer
    Harness.NativeContracts
    MiniJson
    NativeTokenSpec
    Rv32Fixture
    Rv32Model
    Rv32Spec
    Rv32Support
    Rv32Vectors
    SyscallEntrySpec
    TablesSpec
    XdrSpec
  build-depends:
    hog-exec-hs, bytestring, containers, hspec, QuickCheck, vector, crypton, memory, directory, base16-bytestring, network, stm
