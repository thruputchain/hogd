    Hogd.Exec.Runtime.Item.SnapshotStorageItem
    Hogd.Exec.Runtime.Item.StorageSnapshotCache
    Hogd.Exec.Runtime.NativeRuntime
    Hogd.Exec.Runtime.PreparedContract
