        for (size_t sample : metric.samples) {
          w.value(static_cast<std::int64_t>(sample));
        }
      }
    }

    co_return os.str();
  }

private:
  struct Metric {
    // [samples] is protected by the component lock. This is synchronization
    // is very coarse-grained and we should ultimately replace this with a
    // synchronized map that uses [x23::CoroLock]'s rather than
    // [std::mutex]'s.
    std::vector<size_t> samples;
  };

  struct Component {
    x23::CoroLock lock;
    std::unique_ptr<std::unordered_map<std::string, Metric>> metrics;
  };

  Metrics() = default;

  std::array<Component, kNumComponents> components_;
};

} // namespace hogd
