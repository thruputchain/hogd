+// ---- gbh-diag: diagnostic branch only, not for merge ----
+// Offsets inside `object` whose pointer-sized word equals `pointer`: where a
+// member storing that pointer lives, for private members the dump cannot name.
+std::string
+diag_pointer_offsets(const void *object, size_t size, const void *pointer)
+{
+  std::string out;
+  const auto value = reinterpret_cast<uintptr_t>(pointer);
+  for (size_t off = 0; off + sizeof(value) <= size; off += alignof(uintptr_t)) {
+    uintptr_t word = 0;
+    std::memcpy(&word, static_cast<const uint8_t *>(object) + off,
+                sizeof(word));
+    if (word == value) {
+      out += std::format("{}{:#x}", out.empty() ? "" : ",", off);
+    }
+  }
+  return out.empty() ? std::string("-") : out;
+}
+
+// One line per row invocation, when RV32_GBH_DIAG_ADDRS is set: where the
+// data the crossing rows touch landed.
+[[gnu::noinline]] void
+diag_dump(std::string_view where, std::string_view row,
+          SyscallBenchFixture &fixture, const void *guest_memory,
+          const void *machine, const void *gas, const void *exec)
+{
+  static const bool enabled = std::getenv("RV32_GBH_DIAG_ADDRS") != nullptr;
+  if (!enabled) {
+    return;
+  }
+  SystemCallHandler &handler = fixture.handler();
+  const std::shared_ptr<StorageSnapshotCache> cache =
+      fixture.framework().get_storage_snapshot_cache();
+  const auto &tip = cache->get_db_tip();
+  int marker = 0;
+  std::println(
+      stderr,
+      "gbh-diag-addr where={} row={} fixture={} fixture_size={:#x} handler={} "
+      "handler_size={:#x} handler_cache_off={} cache={} cache_size={:#x} "
+      "cache_tip_off={} tip={} tip_size={:#x} height={} guest={} out_a={} "
+      "machine={} gas={} exec={} stack={}",
+      where, row, static_cast<const void *>(&fixture),
+      sizeof(SyscallBenchFixture), static_cast<const void *>(&handler),
+      sizeof(SystemCallHandler),
+      diag_pointer_offsets(&handler, sizeof(SystemCallHandler), cache.get()),
+      static_cast<const void *>(cache.get()), sizeof(StorageSnapshotCache),
+      diag_pointer_offsets(cache.get(), sizeof(StorageSnapshotCache), &tip),
+      static_cast<const void *>(&tip), sizeof(tip),
+      static_cast<const void *>(&tip.value.proposal_header.block_height),
+      guest_memory,
+      static_cast<const void *>(static_cast<const uint8_t *>(guest_memory) +
+                                kOutputAddressA),
+      machine, gas, exec, static_cast<const void *>(&marker));
+}
