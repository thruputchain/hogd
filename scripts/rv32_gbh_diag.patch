+// ---- gbh-diag rows: diagnostic branch only, not for merge ----
+// Where a diag row's fixture lives: in the row's own frame (as vm/ rows do),
+// on the heap, or the shared static one (as entry/ rows do).
+enum class DiagFixture : uint8_t { kStack, kHeap, kShared };
+
+constexpr std::string_view
+diag_fixture_name(DiagFixture where)
+{
+  switch (where) {
+  case DiagFixture::kStack:
+    return "stack";
+  case DiagFixture::kHeap:
+    return "heap";
+  case DiagFixture::kShared:
+    return "shared";
+  }
+  return "unknown";
+}
+
+class DiagFixtureHolder {
+public:
+  DiagFixtureHolder(benchmark::State &state, DiagFixture where)
+  {
+    switch (where) {
+    case DiagFixture::kShared:
+      // fixture_or_fail has already failed the row when it returns nullptr.
+      fixture_ = fixture_or_fail(state);
+      return;
+    case DiagFixture::kHeap:
+      heap_ = std::make_unique<SyscallBenchFixture>();
+      fixture_ = heap_.get();
+      break;
+    case DiagFixture::kStack:
+      stack_.emplace();
+      fixture_ = &*stack_;
+      break;
+    }
+    if (!fixture_->setup_error().empty()) {
+      state.SkipWithError(fixture_->setup_error());
+      fixture_ = nullptr;
+    }
+  }
+  DiagFixtureHolder(const DiagFixtureHolder &) = delete;
+  DiagFixtureHolder &operator=(const DiagFixtureHolder &) = delete;
+
+  [[nodiscard]] SyscallBenchFixture *get() const { return fixture_; }
+
+private:
+  std::optional<SyscallBenchFixture> stack_;
+  std::unique_ptr<SyscallBenchFixture> heap_;
+  SyscallBenchFixture *fixture_ = nullptr;
+};
+
+// bm_syscall_vm's loop against a fixture placed by `where`.
+void
+bm_diag_vm(benchmark::State &state, SyscallCall call, DiagFixture where)
+{
+  DiagFixtureHolder holder(state, where);
+  if (holder.get() == nullptr) {
+    return;
+  }
+  SyscallBenchFixture &fixture = *holder.get();
+  constexpr uint32_t kIterationsPerRun = 512;
+  const std::vector<uint8_t> code = make_ecall_program(call, kIterationsPerRun);
+  std::vector<uint8_t> initial_memory = make_guest_memory();
+  apply_row_key(initial_memory, call);
+  auto program =
+      rv32::ThreadedMachinePreInstantiation::create(code, initial_memory, 0,
+                                                    kGuestMemoryBytes,
+                                                    /*trace=*/false);
+  if (!program.has_value()) {
+    std::abort();
+  }
+  rv32::ThreadedMachine machine(*program, kPlentyOfGas);
+  diag_dump(std::format("vm_{}", diag_fixture_name(where)), call.name,
+            fixture, machine.memory().data(), &machine,
+            &machine.gas_remaining_, machine.exec_.data());
+
+  int64_t calls = 0;
+  for (auto _ : state) {
+    state.PauseTiming();
+    machine.reset(kPlentyOfGas);
+    state.ResumeTiming();
+    rv32::StepResult result = machine.start();
+    uint64_t served = 0;
+    while (result == rv32::StepResult::kEcall) {
+      const auto pending = machine.pending_ecall();
+      ExecutionContext context = {
+          .memory = std::as_writable_bytes(machine.memory()),
+          .gas_remaining = machine.gas_remaining(),
+      };
+      auto [host_result, gas_consumed] =
+          syscall_entry(&fixture.handler(), context, pending->a0, pending->a1,
+                        pending->a2, pending->a3, pending->a4, pending->a5,
+                        pending->a6, pending->a7)();
+      if (!host_result.has_value()) {
+        state.SkipWithError(
+            std::format("{}: host error {}", call.name,
+                        static_cast<int>(host_result.error().code())));
+        return;
+      }
+      if (*host_result != SyscallErrorCode::kSyscallErrorCodeNone) {
+        break;
+      }
+      ++served;
+      result = machine.resume_from_ecall(
+          rv32::HostResult::continue_with(std::to_underlying(*host_result),
+                                          gas_consumed));
+    }
+    if (served != kIterationsPerRun) {
+      state.SkipWithError(std::format("{}: guest made {} calls, expected {}",
+                                      call.name, served, kIterationsPerRun));
+      return;
+    }
+    calls += static_cast<int64_t>(served);
+  }
+
+  state.SetItemsProcessed(calls);
+  state.counters["ns_per_call"] =
+      benchmark::Counter(static_cast<double>(calls),
+                         benchmark::Counter::kIsRate |
+                             benchmark::Counter::kInvert);
+}
+
+// bm_syscall_entry's loop against a fixture placed by `where`.
+void
+bm_diag_entry(benchmark::State &state, SyscallCall call, DiagFixture where)
+{
+  DiagFixtureHolder holder(state, where);
+  if (holder.get() == nullptr) {
+    return;
+  }
+  SyscallBenchFixture &fixture = *holder.get();
+  std::vector<uint8_t> memory = make_guest_memory();
+  const std::span<uint8_t> memory_span(memory);
+  apply_row_key(memory_span, call);
+  diag_dump(std::format("entry_{}", diag_fixture_name(where)), call.name,
+            fixture, memory.data(), nullptr, nullptr, nullptr);
+  const SyscallOutcome warm =
+      invoke_syscall_entry(fixture.handler(), memory_span, call);
+  if (!warm.ok) {
+    fail_row(state, call, warm);
+    return;
+  }
+  int64_t calls = 0;
+  for (auto _ : state) {
+    benchmark::DoNotOptimize(
+        invoke_syscall_entry(fixture.handler(), memory_span, call).gas);
+    benchmark::DoNotOptimize(memory.data());
+    benchmark::ClobberMemory();
+    ++calls;
+  }
+  state.SetItemsProcessed(calls);
+}
