#pragma once

#define X23_NAME "@PROJECT_NAME@"
#define X23_VERSION "@PROJECT_VERSION@"

#define X23_PACKAGE_STRING X23_NAME " " X23_VERSION

// Set to 1 if you are on x86 and the compiler supports __builtin_ia32_pause.
#cmakedefine01 HAVE_BUILTIN_IA32_PAUSE

// Set to 1 if you are on arm and the compiler supports __builtin_arm_yield.
#cmakedefine01 HAVE_BUILTIN_ARM_YIELD

// Set to 1 if <new> properly defines hardware_destructive_interference_size.
#cmakedefine01 HAVE_HARDWARE_DESTRUCTIVE_INTERFERENCE_SIZE

// Set to 1 if your operating system supports epoll
#cmakedefine01 HAVE_EPOLL

// Set to 1 if your operating system supports the accept4 syscall
#cmakedefine01 HAVE_ACCEPT4
