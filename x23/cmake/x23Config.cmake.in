@PACKAGE_INIT@

if (NOT CMAKE_CXX_STANDARD)
  set(CMAKE_CXX_STANDARD 23)
  set(CMAKE_CXX_STANDARD_REQUIRED ON)
  if (CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(STATUS "Using Clang, setting libc++")
    add_compile_options(-stdlib=libc++ -fexperimental-library)
    add_link_options(-stdlib=libc++ -fexperimental-library)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/x23Targets.cmake")

get_target_property(x23_INCLUDE_DIRS x23 INTERFACE_INCLUDE_DIRECTORIES)

if(CMAKE_CROSSCOMPILING)
  find_program(X23C_EXECUTABLE x23c REQUIRED)
else()
  set_and_check(X23C_EXECUTABLE
    "${PACKAGE_PREFIX_DIR}/bin/x23c${CMAKE_EXECUTABLE_SUFFIX}")
endif()
message(STATUS "X23C_EXECUTABLE is ${X23C_EXECUTABLE}")

#
# Creates a header-only interface library from one or more .x files.
# Example:
#
#    add_xdr(protocol my_prot.x my_other_prot.x)
#
#    add_executable(myprog src.cc)
#    target_link_libraries(myprog protocol)
#
function(add_xdr target_name)
  set(xdr_headers)
  foreach(xdr_file IN LISTS ARGN)
    set(xdr_file "${CMAKE_CURRENT_SOURCE_DIR}/${xdr_file}")
    get_filename_component(base_name ${xdr_file} NAME_WLE)
    set(output_file "${CMAKE_CURRENT_BINARY_DIR}/${base_name}.hh")
    add_custom_command(
      OUTPUT ${output_file}
      COMMAND ${X23C_EXECUTABLE} -o ${output_file} ${xdr_file}
      DEPENDS ${xdr_file}
      COMMENT "Generating ${output_file} from ${xdr_file}"
    )
    list(APPEND xdr_headers ${output_file})
  endforeach()

  add_library(${target_name} INTERFACE)
  target_include_directories(${target_name}
    INTERFACE "${CMAKE_CURRENT_BINARY_DIR}")
  target_link_libraries(${target_name} INTERFACE x23)

  add_custom_target(build_${target_name} ALL DEPENDS ${xdr_headers})
  add_dependencies(${target_name} build_${target_name})
endfunction()

#
# Transforms a target that includes source files ending .x so that it
# can include the generated .hh files.  Example:
#
#    add_executable(test test.cc myprot.x)
#    use_x23(test)
#
function(use_x23 target)
  get_target_property(target_sources ${target} SOURCES)
  set(generated_headers)

  foreach(source ${target_sources})
    if(${source} MATCHES ".*\\.x$")
      get_filename_component(basename ${source} NAME_WLE)
      set(output_file "${CMAKE_CURRENT_BINARY_DIR}/${basename}.hh")
      add_custom_command(
        OUTPUT ${output_file}
        COMMAND ${X23C_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/${source}
        COMMENT "Generating ${output_file} from ${source}"
      )
      list(APPEND generated_headers ${output_file})
    endif()
  endforeach()

  if(generated_headers)
    add_custom_target(${target}_generate_x23_headers
      DEPENDS ${generated_headers}
    )
    add_dependencies(${target} ${target}_generate_x23_headers)
    target_sources(${target} PRIVATE ${generated_headers})
    target_link_libraries(${target} PUBLIC x23)
    target_include_directories(${target} PUBLIC "${CMAKE_CURRENT_BINARY_DIR}")
  endif()
endfunction()

check_required_components(x23)
