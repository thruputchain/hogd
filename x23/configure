#!/bin/bash

# This project uses cmake.  However, this configure script emulates
# the most basic arguments of an autotools configure script, so as to
# facilitate integration with package managers that use autotools.

unset prefix
src_dir=$(dirname "$0")
extra_cmake_args=()

for arg in "$@"; do
  case $arg in
    --prefix=*)
      prefix="${arg#*=}"
      ;;
    CXX=*)
      CXX="${arg#*=}"
      extra_cmake_args+=("-DCMAKE_CXX_COMPILER=${CXX}")
      ;;
    CXXFLAGS=*)
      CXXFLAGS="${arg#*=}"
      extra_cmake_args+=("-DCMAKE_CXX_FLAGS=${CXXFLAGS}")
      ;;
    CC=*)
      CC="${arg#*=}"
      extra_cmake_args+=("-DCMAKE_C_COMPILER=${CC}")
      ;;
    CFLAGS=*)
      CFLAGS="${arg#*=}"
      extra_cmake_args+=("-DCMAKE_C_FLAGS=${CFLAGS}")
      ;;
    *)
      echo "Unknown argument $arg"
      ;;
  esac
done

cmake "$src_dir" ${prefix+-DCMAKE_INSTALL_PREFIX="$prefix"} "${extra_cmake_args[@]}"
